package templates

templ APIKeysTab(userEmail string, project Project, allProjects []Project, keys []APIKey, revealedKey string, message Message) {
	@Layout(project.Name+" · API Keys", userEmail, Sidebar{Projects: allProjects, ProjectID: project.ID, ActiveNav: "api-keys"}) {
		@PageHeader("API Keys")
		if revealedKey != "" {
			<article class="callout-card-warning">
				<p><strong>Save this key now — it cannot be shown again:</strong></p>
				<pre><code>{ revealedKey }</code></pre>
			</article>
		}
		@Callout(message)
		<table>
			<thead>
				<tr><th>Name</th><th>Prefix</th><th>Scope</th><th>Created</th><th>Status</th><th></th></tr>
			</thead>
			<tbody>
				if len(keys) == 0 {
					@EmptyState(6, "No API keys created yet.")
				}
				for _, k := range keys {
					<tr>
						<td>{ k.Name }</td>
						<td><code>{ k.KeyPrefix }</code></td>
						<td>{ k.Scope }</td>
						<td>{ k.CreatedAt.Format("2006-01-02 15:04") }</td>
						if k.Revoked {
							<td>@StatusBadge("revoked")</td>
						} else {
							<td>@StatusBadge("active")</td>
						}
						<td>
							if !k.Revoked {
								<form method="post" action={ templ.URL("/projects/" + project.ID + "/api-keys/" + k.ID + "/revoke") } class="inline-form">
									<button type="submit" class="outline danger">Revoke</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>

		<article>
			<header>Create API key</header>
			<form method="post" action={ templ.URL("/projects/" + project.ID + "/api-keys") }>
				<label>Name <input type="text" name="name" required/></label>
				<label>
					Scope
					<select name="scope">
						<option value="send">send</option>
						<option value="read">read</option>
					</select>
				</label>
				<button type="submit">Create</button>
			</form>
		</article>
	}
}
