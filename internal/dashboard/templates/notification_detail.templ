package templates

import "strconv"

templ recipientRows(recipients []Recipient) {
	<thead>
		<tr><th>Device</th><th>Provider</th><th>Status</th><th>Message ID</th><th>Error</th><th>Attempts</th></tr>
	</thead>
	<tbody>
		if len(recipients) == 0 {
			@EmptyState(6, "No recipients resolved yet.")
		}
		for _, r := range recipients {
			<tr>
				<td>@IDValue(r.DeviceID)</td>
				<td>{ r.ProviderType }</td>
				<td>@StatusBadge(r.Status)</td>
				<td>@IDValue(r.ProviderMessageID)</td>
				if r.ErrorMessage == "" {
					<td><span class="muted">&mdash;</span></td>
				} else {
					<td>{ r.ErrorMessage }</td>
				}
				<td>{ strconv.Itoa(int(r.AttemptCount)) }</td>
			</tr>
		}
	</tbody>
}

// RecipientsFragment renders the recipients table, still polling via htmx
// when not yet terminal. Used both as part of NotificationDetail's initial
// page and as the bare fragment htmx polls.
templ RecipientsFragment(notificationID string, recipients []Recipient, terminal bool) {
	if terminal {
		<table id="recipients">
			@recipientRows(recipients)
		</table>
	} else {
		<table id="recipients" hx-get={ "/notifications/" + notificationID + "/recipients-fragment" } hx-trigger="every 2s" hx-swap="outerHTML">
			@recipientRows(recipients)
		</table>
	}
}

templ NotificationDetail(userEmail string, project Project, allProjects []Project, notificationID string, status string, total int32, counts RecipientCounts, recipients []Recipient, terminal bool) {
	@Layout("Notification "+notificationID, userEmail, Sidebar{Projects: allProjects, ProjectID: project.ID, ActiveNav: "notifications"}) {
		<div class="page-header">
			<h1>Notification <code>{ notificationID }</code></h1>
		</div>
		<div class="stat-row">
			<div class="stat">
				<span class="stat-label">Status</span>
				@StatusBadge(status)
			</div>
			<div class="stat">
				<span class="stat-label">Total</span>
				<span class="stat-value">{ strconv.Itoa(int(total)) }</span>
			</div>
			<div class="stat">
				<span class="stat-label">Queued</span>
				<span class="stat-value">{ strconv.FormatInt(counts.Queued, 10) }</span>
			</div>
			<div class="stat">
				<span class="stat-label">Sending</span>
				<span class="stat-value">{ strconv.FormatInt(counts.Sending, 10) }</span>
			</div>
			<div class="stat">
				<span class="stat-label">Sent</span>
				<span class="stat-value">{ strconv.FormatInt(counts.Sent, 10) }</span>
			</div>
			<div class="stat">
				<span class="stat-label">Delivered</span>
				<span class="stat-value">{ strconv.FormatInt(counts.Delivered, 10) }</span>
			</div>
			<div class="stat">
				<span class="stat-label">Failed</span>
				<span class="stat-value">{ strconv.FormatInt(counts.Failed, 10) }</span>
			</div>
		</div>
		@RecipientsFragment(notificationID, recipients, terminal)
	}
}
