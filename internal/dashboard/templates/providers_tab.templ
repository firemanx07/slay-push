package templates

templ ProvidersTab(userEmail string, project Project, allProjects []Project, credentials []ProviderCredential, message Message) {
	@Layout(project.Name+" · Providers", userEmail, Sidebar{Projects: allProjects, ProjectID: project.ID, ActiveNav: "providers"}) {
		@PageHeader("Providers")
		@Callout(message)
		<table>
			<thead>
				<tr><th>Provider</th><th>Environment</th><th>Active</th><th>Updated</th><th></th></tr>
			</thead>
			<tbody>
				if len(credentials) == 0 {
					@EmptyState(5, "No provider credentials configured yet.")
				}
				for _, c := range credentials {
					<tr>
						<td>{ c.ProviderType }</td>
						<td>{ c.Environment }</td>
						if c.IsActive {
							<td>@StatusBadge("yes")</td>
						} else {
							<td>@StatusBadge("no")</td>
						}
						<td>{ c.UpdatedAt.Format("2006-01-02 15:04") }</td>
						<td>
							<form method="post" action={ templ.URL("/projects/" + project.ID + "/providers/test") } class="inline-form">
								<input type="hidden" name="provider" value={ c.ProviderType }/>
								<button type="submit" class="outline secondary">Test</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>

		<article>
			<header>Add / update credential</header>
			<form method="post" action={ templ.URL("/projects/" + project.ID + "/providers") }>
				<label>
					Provider
					<select name="provider">
						<option value="expo">expo</option>
						<option value="fcm">fcm</option>
						<option value="apns">apns</option>
						<option value="hms">hms</option>
					</select>
				</label>
				<label>
					Credential JSON
					<textarea name="credential" rows="6" required></textarea>
				</label>
				<button type="submit">Save credential</button>
			</form>
		</article>
	}
}
