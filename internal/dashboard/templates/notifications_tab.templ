package templates

import "strconv"

templ NotificationsTab(userEmail string, project Project, notifications []Notification) {
	@Layout(project.Name + " · Notifications", userEmail) {
		<p><a href={ templ.URL("/projects/" + project.ID) }>&larr; { project.Name }</a></p>
		@ProjectNav(project.ID, "notifications")
		<h1>Send History</h1>
		<table>
			<thead>
				<tr><th>Status</th><th>Recipients</th><th>Created</th><th></th></tr>
			</thead>
			<tbody>
				for _, n := range notifications {
					<tr>
						<td>{ n.Status }</td>
						<td>{ strconv.Itoa(int(n.TotalRecipients)) }</td>
						<td>{ n.CreatedAt.Format("2006-01-02 15:04") }</td>
						<td><a href={ templ.URL("/notifications/" + n.ID) }>Detail</a></td>
					</tr>
				}
			</tbody>
		</table>
	}
}
