package templates

import "strconv"

templ NotificationsTab(userEmail string, project Project, allProjects []Project, notifications []Notification) {
	@Layout(project.Name+" · Notifications", userEmail, Sidebar{Projects: allProjects, ProjectID: project.ID, ActiveNav: "notifications"}) {
		@PageHeader("Send History")
		<table>
			<thead>
				<tr><th>Status</th><th>Recipients</th><th>Created</th><th></th></tr>
			</thead>
			<tbody>
				if len(notifications) == 0 {
					@EmptyState(4, "No notifications sent yet.")
				}
				for _, n := range notifications {
					<tr>
						<td>@StatusBadge(n.Status)</td>
						<td>{ strconv.Itoa(int(n.TotalRecipients)) }</td>
						<td>{ n.CreatedAt.Format("2006-01-02 15:04") }</td>
						<td><a href={ templ.URL("/notifications/" + n.ID) }>Detail</a></td>
					</tr>
				}
			</tbody>
		</table>
	}
}
