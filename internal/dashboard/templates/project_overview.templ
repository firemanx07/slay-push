package templates

templ ProjectOverview(userEmail string, project Project) {
	@Layout(project.Name, userEmail) {
		<p><a href="/projects">&larr; Projects</a></p>
		<h1>{ project.Name }</h1>
		@ProjectNav(project.ID, "overview")
		<article>
			<header>Overview</header>
			<p>Slug: <code>{ project.Slug }</code></p>
			<p>Status: { project.Status }</p>
		</article>
	}
}
