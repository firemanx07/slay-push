package templates

templ Home(userEmail string, projects []Project) {
	@Layout("Dashboard", userEmail, Sidebar{Projects: projects}) {
		@PageHeader("Dashboard")
		<article>
			<header>
				<span>Projects</span>
				<a href="/projects" role="button" class="outline">Manage projects &rarr;</a>
			</header>
			if len(projects) == 0 {
				<p class="empty-state">No projects yet.</p>
			} else {
				<ul class="item-list">
					for _, p := range projects {
						<li><a href={ templ.URL("/projects/" + p.ID) }>{ p.Name }</a> <small>({ p.Slug })</small></li>
					}
				</ul>
			}
		</article>
	}
}
