package templates

templ Home(userEmail string, projects []Project) {
	@Layout("Dashboard", userEmail) {
		<h1>Dashboard</h1>
		<article>
			<header>
				<strong>Projects</strong>
				<a href="/projects" role="button" class="outline" style="float:right;">Manage projects &rarr;</a>
			</header>
			<ul>
				for _, p := range projects {
					<li><a href={ templ.URL("/projects/" + p.ID) }>{ p.Name }</a> <small>({ p.Slug })</small></li>
				}
			</ul>
		</article>
	}
}
