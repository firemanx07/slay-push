package templates

templ ProjectsList(userEmail string, projects []Project, errorMessage string) {
	@Layout("Projects", userEmail) {
		<p><a href="/">&larr; Dashboard</a></p>
		<h1>Projects</h1>
		if errorMessage != "" {
			<p class="error">{ errorMessage }</p>
		}
		<article>
			<header>Create a project</header>
			<form method="post" action="/projects">
				<label>Name <input type="text" name="name" required/></label>
				<label>Slug <input type="text" name="slug" required/></label>
				<button type="submit">Create project</button>
			</form>
		</article>
		<ul>
			for _, p := range projects {
				<li><a href={ templ.URL("/projects/" + p.ID) }>{ p.Name }</a> <small>({ p.Slug }, { p.Status })</small></li>
			}
		</ul>
	}
}
