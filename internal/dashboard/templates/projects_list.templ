package templates

templ ProjectsList(userEmail string, projects []Project, message Message) {
	@Layout("Projects", userEmail, Sidebar{Projects: projects}) {
		@PageHeader("Projects")
		@Callout(message)
		<article>
			<header>Create a project</header>
			<form method="post" action="/projects">
				<label>Name <input type="text" name="name" required/></label>
				<label>Slug <input type="text" name="slug" required/></label>
				<button type="submit">Create project</button>
			</form>
		</article>
		if len(projects) == 0 {
			<p class="empty-state">No projects yet — create one above.</p>
		} else {
			<ul class="item-list">
				for _, p := range projects {
					<li><a href={ templ.URL("/projects/" + p.ID) }>{ p.Name }</a> <small>({ p.Slug }, { p.Status })</small></li>
				}
			</ul>
		}
	}
}
