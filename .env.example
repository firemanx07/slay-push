# Copy to .env and adjust before running `docker compose up`.
# Most operator-facing settings (auth mode, OIDC, rate-limit overrides) live
# in the database and are edited from the dashboard after first-run setup —
# these env vars only cover what's needed before the DB is even reachable.

# Postgres password for the app-created "pushdispatch" database/user.
POSTGRES_PASSWORD=changeme

# Port the dashboard/API is exposed on (host side).
APP_PORT=8080

# AES-256-GCM master key for encrypting provider credentials at rest.
# Required starting Phase 3; unused before that. Generate with:
#   openssl rand -base64 32
# WARNING: losing this key makes stored provider credentials unrecoverable —
# there is no external KMS in this self-hosted design. Save it somewhere safe.
APP_MASTER_KEY=

# json (default, prod) or seq (only meaningful with docker-compose.dev.yml)
LOG_FORMAT=json
LOG_LEVEL=info

# Marks the dashboard session cookie Secure (HTTPS-only). Set to false only
# for local plain-HTTP development.
APP_COOKIE_SECURE=true
